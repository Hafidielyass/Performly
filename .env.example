# Copy this file to .env before running `docker-compose up`.
# All values below are safe local-dev defaults — change secrets before any real deployment.

# ---- Postgres ----
POSTGRES_USER=performly
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=performly
POSTGRES_PORT=5432

# Consumed by the backend container (Prisma). Host is the compose service name.
DATABASE_URL=postgresql://performly:change_me_dev_password@postgres:5432/performly?schema=public

# ---- Auth ----
JWT_SECRET=change_me_dev_jwt_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- Ports exposed on the host ----
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ---- Frontend -> Backend ----
# URL the Next.js server/browser uses to reach the API from outside the compose network.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- CORS ----
# Comma-separated list of origins allowed to call the API with credentials (cookies).
# The backend refuses to start without this set - there is no "allow any origin" fallback.
# Add every origin the frontend is actually served from (e.g. a deployed HTTPS domain).
CORS_ORIGIN=http://localhost:3000

# ---- Reverse proxy / load balancer ----
# Set TRUST_PROXY=1 when the backend runs behind a single trusted reverse proxy
# (nginx, Traefik, LB, ...): rate limiting then keys on X-Forwarded-For instead of
# the proxy's IP. Leave 0 when the API is directly reachable.
TRUST_PROXY=0

NODE_ENV=development
